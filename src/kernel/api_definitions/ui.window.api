    {"name": "x", "field_type": "i32", "internal_mapping": "rect.x", "readable": true, "writable": false},
    {"name": "y", "field_type": "i32", "internal_mapping": "rect.y", "readable": true, "writable": false},
    {"name": "width", "field_type": "u32", "internal_mapping": "rect.width", "readable": true, "writable": false},
    {"name": "height", "field_type": "u32", "internal_mapping": "rect.height", "readable": true, "writable": false},
    {"name": "state", "field_type": "u8", "internal_mapping": "props.state", "readable": true, "writable": false},
    {"name": "z_order", "field_type": "u32", "internal_mapping": "props.z_order", "readable": true, "writable": false}
  ],
  "write_fields": [
    {"name": "submit_buffer", "field_type": "command", "internal_mapping": "ctl.submit_buffer", "readable": false, "writable": true},
    {"name": "resize", "field_type": "command", "internal_mapping": "ctl.resize", "readable": false, "writable": true},
    {"name": "move", "field_type": "command", "internal_mapping": "ctl.move", "readable": false, "writable": true},
    {"name": "minimize", "field_type": "command", "internal_mapping": "ctl.minimize", "readable": false, "writable": true},
    {"name": "maximize", "field_type": "command", "internal_mapping": "ctl.maximize", "readable": false, "writable": true},
    {"name": "close", "field_type": "command", "internal_mapping": "ctl.close", "readable": false, "writable": true}
  ],
  "rate_limit": {"max_calls_per_sec": 120},
  "audit": false
}
