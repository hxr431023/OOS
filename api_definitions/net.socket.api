      "internal_mapping": "ctl.connect",
      "readable": false,
      "writable": true
    },
    {
      "name": "listen",
      "field_type": "command",
      "internal_mapping": "ctl.listen",
      "readable": false,
      "writable": true
    },
    {
      "name": "close",
      "field_type": "command",
      "internal_mapping": "ctl.close",
      "readable": false,
      "writable": true
    },
    {
      "name": "bind",
      "field_type": "command",
      "internal_mapping": "ctl.bind",
      "readable": false,
      "writable": true
    }
  ],
  "rate_limit": {
    "max_calls_per_sec": 10000
  },
  "audit": true
}
